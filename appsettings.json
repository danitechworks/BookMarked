{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BookMarked;Trusted_Connection=True;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
